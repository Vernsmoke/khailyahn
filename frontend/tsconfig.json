{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/link": [
        "./src/compat/link.tsx"
      ],
      "next/image": [
        "./src/compat/image.tsx"
      ],
      "next/navigation": [
        "./src/compat/navigation.ts"
      ],
      "next/dynamic": [
        "./src/compat/dynamic.tsx"
      ]
    }
  },
  "include": [
    "src"
  ]
}
